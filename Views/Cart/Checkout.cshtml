@using Gamesgiftshop.Models
@inject Csi402dbContext _db

@{
    ViewData["Title"] = "ชำระเงิน - Games Gift Shop";
    
    decimal grandTotal = ViewBag.GrandTotal ?? 0;
    decimal discount = ViewBag.Discount ?? 0;

    var currentUsername = User.Identity.Name;
    var currentUser = _db.Users.FirstOrDefault(u => u.Username == currentUsername);

    // ดึงข้อมูลที่อยู่
    List<Useraddress> addresses = new List<Useraddress>();
    if (currentUser != null)
    {
        addresses = _db.Useraddresses.Where(a => a.UserId == currentUser.UserId).ToList();
    }

    var mainAddress = addresses.FirstOrDefault(a => a.IsDefault == true) ?? addresses.FirstOrDefault();
    string defaultAddressVal = mainAddress != null ? mainAddress.AddressDetail : "";
}

<!-- ⭐️ นำเข้าไลบรารี SweetAlert2 สำหรับทำ Alert สวยๆ ⭐️ -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* ================= ธีม Dark Minimalist ================= */
    body { background-color: #0f1115; color: #e2e8f0; }
    
    .back-link { color: #94a3b8; text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; transition: 0.2s; margin-bottom: 25px; }
    .back-link:hover { color: #ffffff; }
    
    .page-title-checkout { color: #ffffff; font-weight: 800; font-size: 1.8rem; display: flex; align-items: center; gap: 12px; margin-bottom: 30px; letter-spacing: 0.5px; }
    .page-title-checkout::before { content: ''; display: inline-block; width: 6px; height: 24px; background: linear-gradient(180deg, #6366f1 0%, #a855f7 100%); border-radius: 4px; }

    .checkout-card { background-color: #16181f; border: 1px solid #222631; border-radius: 16px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); height: 100%; }

    .section-header { font-size: 1.05rem; font-weight: 800; color: #ffffff; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; letter-spacing: 0.5px; }
    .section-header::before { content: ''; display: inline-block; width: 3px; height: 16px; background-color: #6366f1; border-radius: 2px; }

    .address-list { max-height: 380px; overflow-y: auto; padding-right: 5px; margin-bottom: 20px; }
    .address-list::-webkit-scrollbar { width: 6px; }
    .address-list::-webkit-scrollbar-track { background: #0f1115; border-radius: 4px; }
    .address-list::-webkit-scrollbar-thumb { background-color: #334155; border-radius: 4px; }

    .address-label { display: block; cursor: pointer; margin-bottom: 15px; }
    .address-label input[type="radio"] { display: none; }

    .address-box { background-color: #0f1115; border: 1px solid #334155; border-radius: 12px; padding: 20px; position: relative; transition: all 0.2s ease; }
    .address-box:hover { border-color: #475569; }

    .address-label input[type="radio"]:checked + .address-box { border-color: #6366f1; box-shadow: 0 0 0 1px #6366f1 inset, 0 4px 15px rgba(99, 102, 241, 0.15); background-color: #1a1d24; }
    
    .address-badge { position: absolute; top: 20px; right: 20px; background-color: #1e293b; color: #cbd5e1; font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; border: 1px solid #334155; transition: 0.2s; }
    .address-label input[type="radio"]:checked + .address-box .address-badge { background-color: #6366f1; color: white; border-color: #6366f1; }

    .btn-add-address { background-color: transparent; color: #94a3b8; border: 1px dashed #475569; width: 100%; padding: 12px; border-radius: 12px; font-weight: 600; transition: 0.2s; text-decoration: none; display: block; text-align: center; }
    .btn-add-address:hover { background-color: #1e293b; color: white; border-color: #64748b; }

    .total-amount-box { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; }
    .total-amount-label { color: #94a3b8; font-size: 0.95rem; }
    .total-amount-value { color: #6366f1; font-size: 2rem; font-weight: 900; }

    .qr-container { text-align: center; margin-bottom: 30px; }
    .qr-instruction { color: #64748b; font-size: 0.85rem; margin-bottom: 15px; }
    .qr-box { background-color: #ffffff; padding: 15px; border-radius: 12px; display: inline-block; margin-bottom: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    .qr-box img { width: 180px; height: 180px; }
    .acc-name { color: #ffffff; font-weight: 700; font-size: 1rem; margin-bottom: 5px; }
    .acc-amount { color: #6366f1; font-weight: 800; font-size: 1.2rem; }

    .upload-instruction { color: #64748b; font-size: 0.85rem; margin-bottom: 10px; }
    .upload-box { border: 2px dashed #334155; border-radius: 12px; padding: 30px; text-align: center; background-color: #0f1115; cursor: pointer; transition: 0.3s; margin-bottom: 20px; }
    .upload-box:hover { border-color: #6366f1; background-color: #1a1d24; }
    .upload-icon { font-size: 2rem; color: #64748b; margin-bottom: 10px; transition: 0.3s; }
    .upload-box:hover .upload-icon { color: #6366f1; }
    .upload-text { color: #94a3b8; font-size: 0.9rem; }
    .upload-text span { color: #6366f1; font-weight: 600; }

    .btn-confirm { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); color: white; width: 100%; border: none; border-radius: 10px; padding: 16px; font-weight: 800; font-size: 1.1rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3); display: flex; justify-content: center; align-items: center; gap: 10px; }
    .btn-confirm:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4); }
</style>

<div class="container mt-4 mb-5">
    
    <a href="/Cart" class="back-link"><i class="fa-solid fa-arrow-left me-2"></i> กลับไปหน้าตะกร้าสินค้า</a>
    
    <h1 class="page-title-checkout">ยืนยันคำสั่งซื้อและการชำระเงิน</h1>
    @if (TempData["CheckoutError"] != null)
    {
        <div class="alert alert-danger">@TempData["CheckoutError"]</div>
    }

    <div class="row g-4">
        
        <!-- ================= ด้านซ้าย: ที่อยู่และสรุปยอด ================= -->
        <div class="col-lg-6">
            <div class="checkout-card flex-column d-flex">
                
                <h3 class="section-header">ที่อยู่สำหรับจัดส่ง</h3>
                
                <div class="address-list">
                    @if (addresses != null && addresses.Any())
                    {
                        foreach(var addr in addresses)
                        {
                            <label class="address-label">
                                <input type="radio" name="addressSelection" value="@addr.AddressDetail" @(addr.IsDefault == true ? "checked" : "") onchange="updateSelectedAddress(this.value)">
                                
                                <div class="address-box">
                                    @if(addr.IsDefault == true)
                                    {
                                        <div class="address-badge">ที่อยู่หลัก</div>
                                    }
                                    
                                    @{
                                        // ⭐️ จัดการแยกชื่อ เบอร์ และที่อยู่ออกจากกัน
                                        string parsedName = currentUser != null ? currentUser.Username : "ชื่อลูกค้า";
                                        string parsedPhone = "";
                                        string parsedAddress = addr.AddressDetail ?? "";

                                        if (parsedAddress.Contains("ชื่อ:") && parsedAddress.Contains("โทร:") && parsedAddress.Contains("ที่อยู่:"))
                                        {
                                            var parts = parsedAddress.Split('|');
                                            if (parts.Length >= 3)
                                            {
                                                parsedName = parts[0].Replace("ชื่อ:", "").Trim();
                                                parsedPhone = parts[1].Replace("โทร:", "").Trim();
                                                parsedAddress = parts[2].Replace("ที่อยู่:", "").Trim();
                                            }
                                        }
                                    }

                                    <!-- บรรทัดบน: ชื่อ + เบอร์โทรศัพท์ -->
                                    <div style="display: flex; align-items: baseline; gap: 15px; margin-bottom: 8px;">
                                        <h5 style="margin-bottom: 0; font-size: 1.15rem; color: #ffffff; font-weight: 700;">@parsedName</h5>
                                        @if(!string.IsNullOrEmpty(parsedPhone))
                                        {
                                            <span style="color: #94a3b8; font-size: 0.9rem;">
                                                <i class="fa-solid fa-phone" style="font-size: 0.8rem; margin-right: 4px;"></i>@parsedPhone
                                            </span>
                                        }
                                    </div>
                                    
                                    <!-- บรรทัดล่าง: รายละเอียดที่อยู่ -->
                                    <div class="address-detail" style="font-size: 1rem; color: #cbd5e1; white-space: pre-line;">
                                        @parsedAddress
                                    </div>
                                </div>
                            </label>
                        }
                    }
                    else
                    {
                        <div class="text-center p-4" style="border: 1px dashed #334155; border-radius: 12px; margin-bottom: 15px;">
                            <i class="fa-solid fa-map-location-dot" style="font-size: 2rem; color: #475569; margin-bottom: 10px;"></i>
                            <p style="color: #94a3b8; margin-bottom: 0;">ยังไม่มีสมุดที่อยู่ กรุณาเพิ่มที่อยู่จัดส่ง</p>
                        </div>
                    }
                </div>

                <a href="/Account/Profile" class="btn-add-address">
                    <i class="fa-solid fa-plus me-1"></i> เพิ่มหรือแก้ไขสมุดที่อยู่
                </a>

                <div class="mt-auto pt-4">
                    <h3 class="section-header">สรุปคำสั่งซื้อ</h3>
                    <div class="total-amount-box">
                        <div>
                            <span class="total-amount-label">ยอดที่ต้องชำระทั้งสิ้น</span>
                            @if (discount > 0)
                            {
                                <div class="small text-success mt-1">หักส่วนลดแล้ว ฿@discount.ToString("N0")</div>
                            }
                        </div>
                        <span class="total-amount-value">฿@grandTotal.ToString("N2")</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- ================= ด้านขวา: ชำระเงินแนบสลิป ================= -->
        <div class="col-lg-6">
            <div class="checkout-card">
                
                <h3 class="section-header">ช่องทางการชำระเงิน (พร้อมเพย์)</h3>
                
                <div class="qr-container">
                    <p class="qr-instruction">สแกนผ่านแอปธนาคาร ระบบระบุยอดชำระ ฿@grandTotal.ToString("N2") ไว้ใน QR แล้ว</p>
                    
                    <div class="qr-box">
                        <img src="@ViewBag.PaymentQrCodeDataUrl" alt="PromptPay QR ระบุยอด ฿@grandTotal.ToString("N2")">
                    </div>
                    
                    <div class="acc-name">ชื่อบัญชี: กิตตินันท์ ภิญโญ</div>
                    <div class="acc-amount">฿@grandTotal.ToString("N2")</div>
                </div>

                <h3 class="section-header mt-4 pt-3 border-top" style="border-color: #222631 !important;">แนบหลักฐานการโอนเงิน</h3>
                <p class="upload-instruction">กรุณาแนบรูปภาพสลิปโอนเงินเพื่อยืนยันคำสั่งซื้อ (รองรับไฟล์ JPG, PNG)</p>

                <!-- ฟอร์มยืนยันคำสั่งซื้อและแนบสลิป (ใส่ onsubmit เพื่อตรวจไฟล์) -->
                <form action="/Cart/ConfirmOrder" method="post" enctype="multipart/form-data" onsubmit="return validateCheckoutForm()">
                    
                    <input type="hidden" id="finalAddressInput" name="address" value="@defaultAddressVal" />

                    <!-- กล่องอัปโหลดที่มีปุ่มกากบาท -->
                    <div style="position: relative; margin-bottom: 20px;">
                        <label class="upload-box w-100 mb-0" for="paymentSlip" id="uploadArea">
                            <div class="upload-icon"><i class="fa-solid fa-camera"></i></div>
                            <div class="upload-text" id="fileNameDisplay"><span>คลิกเพื่ออัปโหลด</span> หรือลากไฟล์มาวางที่นี่</div>
                        </label>
                        
                        <button type="button" id="removeFileBtn" class="btn btn-sm btn-danger d-none" 
                                style="position: absolute; top: 15px; right: 15px; border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; justify-content: center; align-items: center; z-index: 10;" 
                                onclick="clearFileSelection()" title="ลบไฟล์ที่เลือก">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    
                    <input type="file" id="paymentSlip" name="paymentSlip" accept="image/jpeg, image/png, image/jpg" class="d-none" onchange="showFileName(this)">
                    
                    <button type="submit" class="btn-confirm">
                        <i class="fa-solid fa-check-circle"></i> ยืนยันคำสั่งซื้อและส่งสลิป
                    </button>
                </form>

            </div>
        </div>

    </div>
</div>

<script>
    // ส่งข้อมูล Input ที่ซ่อนอยู่เมื่อเปลี่ยนที่อยู่
    function updateSelectedAddress(selectedValue) {
        document.getElementById('finalAddressInput').value = selectedValue;
    }

    // แสดงชื่อไฟล์เมื่ออัปโหลดและเปลี่ยนสไตล์ปุ่ม
    function showFileName(input) {
        const display = document.getElementById('fileNameDisplay');
        const uploadArea = document.getElementById('uploadArea');
        const icon = uploadArea.querySelector('.upload-icon i');
        const removeBtn = document.getElementById('removeFileBtn');
        
        if (input.files && input.files[0]) {
            display.innerHTML = '<span style="color: #10b981;">' + input.files[0].name + '</span>';
            uploadArea.style.borderColor = '#10b981';
            uploadArea.style.backgroundColor = 'rgba(16, 185, 129, 0.05)';
            icon.className = 'fa-solid fa-image';
            icon.style.color = '#10b981';
            removeBtn.classList.remove('d-none');
        } else {
            resetUploadBox();
        }
    }

    // ลบไฟล์ที่เลือกทิ้ง
    function clearFileSelection() {
        const input = document.getElementById('paymentSlip');
        input.value = '';
        resetUploadBox();
    }

    // รีเซ็ตหน้าตากลับไปเป็นตอนยังไม่แนบสลิป
    function resetUploadBox() {
        const display = document.getElementById('fileNameDisplay');
        const uploadArea = document.getElementById('uploadArea');
        const icon = uploadArea.querySelector('.upload-icon i');
        const removeBtn = document.getElementById('removeFileBtn');
        
        display.innerHTML = '<span>คลิกเพื่ออัปโหลด</span> หรือลากไฟล์มาวางที่นี่';
        uploadArea.style.borderColor = '#334155';
        uploadArea.style.backgroundColor = '#0f1115';
        icon.className = 'fa-solid fa-camera';
        icon.style.color = '#64748b';
        removeBtn.classList.add('d-none');
    }

    // ⭐️ ฟังก์ชันตรวจสอบก่อนกดยืนยันคำสั่งซื้อ (SweetAlert2) ⭐️
    function validateCheckoutForm() {
        const slipInput = document.getElementById('paymentSlip');
        
        // เช็คว่ายังไม่ได้เลือกไฟล์ใช่หรือไม่
        if (!slipInput.files || slipInput.files.length === 0) {
            
            // ใช้ SweetAlert2 แสดงแจ้งเตือนสวยๆ
            Swal.fire({
                icon: 'warning',
                title: 'ข้อมูลไม่ครบถ้วน',
                text: 'กรุณาแนบรูปภาพสลิปโอนเงินก่อนทำการยืนยันคำสั่งซื้อครับ',
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#1d67d6',
                background: '#ffffff',
                color: '#173a61'
            });
            
            // เปลี่ยนสีกรอบอัปโหลดให้เป็นสีแดงเพื่อเตือนลูกค้า
            const uploadArea = document.getElementById('uploadArea');
            uploadArea.style.borderColor = '#ef4444';
            uploadArea.style.backgroundColor = 'rgba(239, 68, 68, 0.05)';
            
            return false; // ยกเลิกการส่งฟอร์ม (ไม่ให้ไปต่อ)
        }
        
        return true; // มีไฟล์แล้ว ยอมให้ส่งฟอร์มได้
    }
</script>