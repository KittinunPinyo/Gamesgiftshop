@model Gamesgiftshop.Models.SalesReportViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "รายงานยอดขาย";
    var maxDailySales = Model.DailySales.Select(day => day.NetSales).DefaultIfEmpty(0).Max();
}

<style>
    .report-card { background: #fff; border: 0; border-radius: 14px; box-shadow: 0 4px 18px rgba(30, 41, 59, .07); }
    .report-label { color: #64748b; font-size: .9rem; }
    .report-value { color: #312e81; font-size: 1.7rem; font-weight: 800; }
    .sales-bar { height: 8px; min-width: 2px; border-radius: 8px; background: linear-gradient(90deg, #6366f1, #a855f7); }
</style>

<div class="manager-page-heading">
    <div class="manager-page-icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></div>
    <div>
        <div class="manager-eyebrow">SALES INSIGHTS</div>
        <h1 class="h3 fw-bold mb-1">รายงานยอดขาย</h1>
        <p>สรุปออเดอร์ที่ชำระเงินแล้ว รวมถึงออเดอร์ที่กำลังจัดส่งหรือจัดส่งแล้ว</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="report-card p-4 mb-4">
    <form method="get" asp-action="Reports" class="row g-3 align-items-end">
        <div class="col-sm-4 col-md-3">
            <label class="form-label" for="startDate">ตั้งแต่วันที่</label>
            <input class="form-control" type="date" id="startDate" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
        </div>
        <div class="col-sm-4 col-md-3">
            <label class="form-label" for="endDate">ถึงวันที่</label>
            <input class="form-control" type="date" id="endDate" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
        </div>
        <div class="col-sm-4 col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> ดูรายงาน</button>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="report-card p-4 h-100">
            <div class="report-label">ยอดขายสุทธิ</div>
            <div class="report-value">฿@Model.NetSales.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="report-card p-4 h-100">
            <div class="report-label">ออเดอร์ที่ชำระแล้ว</div>
            <div class="report-value">@Model.PaidOrderCount.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="report-card p-4 h-100">
            <div class="report-label">ยอดเฉลี่ยต่อออเดอร์</div>
            <div class="report-value">฿@Model.AverageOrderAmount.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="report-card p-4 h-100">
            <h2 class="h5 fw-bold mb-3">ยอดขายรายวัน</h2>
            @if (Model.DailySales.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>วันที่</th><th>ออเดอร์</th><th>ยอดขายสุทธิ</th><th style="width: 25%"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var day in Model.DailySales)
                            {
                                var barWidth = maxDailySales > 0 ? (double)(day.NetSales / maxDailySales * 100) : 0;
                                <tr>
                                    <td>@day.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@day.OrderCount</td>
                                    <td>฿@day.NetSales.ToString("N2")</td>
                                    <td><div class="sales-bar" style="width: @barWidth.ToString("0.#")%"></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">ไม่พบออเดอร์ที่ชำระแล้วในช่วงวันที่นี้</div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="report-card p-4 h-100">
            <h2 class="h5 fw-bold mb-1">สินค้าขายดี</h2>
            <div class="small text-muted mb-3">เรียงตามจำนวนชิ้น (ยอดก่อนหักส่วนลดระดับออเดอร์)</div>
            @if (Model.TopProducts.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>สินค้า</th><th class="text-end">จำนวน</th><th class="text-end">ยอดขาย</th></tr></thead>
                        <tbody>
                            @foreach (var product in Model.TopProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td class="text-end">@product.QuantitySold</td>
                                    <td class="text-end">฿@product.GrossSales.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">ยังไม่มีข้อมูลสินค้าขายดีในช่วงวันที่นี้</div>
            }
        </div>
    </div>
</div>
