@model IEnumerable<Gamesgiftshop.Models.Order>
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "จัดการบิลคำสั่งซื้อ";
    var users = ViewBag.Users as List<Gamesgiftshop.Models.User>;
    var orders = Model?.ToList() ?? new List<Gamesgiftshop.Models.Order>();
    var ordersBeingFulfilled = orders.Count(order =>
        order.Status == "ชำระเงินสำเร็จแล้ว" ||
        order.Status == "เตรียมจัดส่ง");
    var orderValue = orders.Sum(order => order.TotalAmount);
}

<style>
    .card-panel { background: #fff; border-radius: 12px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
    .table-admin { width: 100%; border-collapse: collapse; }
    .table-admin th { background: #f7fafc; padding: 15px; text-align: center; border-bottom: 2px solid #e2e8f0; }
    .table-admin td { padding: 15px; text-align: center; border-bottom: 1px solid #edf2f7; vertical-align: middle; }
</style>

<div class="container-fluid mt-2">
    <div class="manager-page-heading">
        <div class="manager-page-icon"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i></div>
        <div>
            <div class="manager-eyebrow">ORDER MANAGEMENT</div>
            <h1>จัดการบิลคำสั่งซื้อ</h1>
            <p>ติดตามรายการคำสั่งซื้อและสถานะการจัดส่ง การตรวจสอบชำระเงินดำเนินการโดยฝ่ายบัญชี</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="manager-stat-card">
                <div class="manager-stat-icon"><i class="fa-solid fa-receipt" aria-hidden="true"></i></div>
                <div>
                    <div class="manager-stat-label">คำสั่งซื้อทั้งหมด</div>
                    <div class="manager-stat-value">@orders.Count.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="manager-stat-card">
                <div class="manager-stat-icon"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></div>
                <div>
                    <div class="manager-stat-label">อยู่ระหว่างจัดเตรียม/จัดส่ง</div>
                    <div class="manager-stat-value">@ordersBeingFulfilled.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="manager-stat-card">
                <div class="manager-stat-icon"><i class="fa-solid fa-wallet" aria-hidden="true"></i></div>
                <div>
                    <div class="manager-stat-label">ยอดคำสั่งซื้อรวม</div>
                    <div class="manager-stat-value">฿@orderValue.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-panel">
        <h3 class="mb-4"><i class="fa-solid fa-list-check me-2"></i>รายการคำสั่งซื้อ</h3>
        
        @if (orders.Any())
        {
            <div class="table-responsive">
                <table class="table-admin">
                    <thead>
                        <tr>
                            <th>รหัสบิล</th>
                            <th>วันที่สั่งซื้อ</th>
                            <th>ลูกค้า</th>
                            <th>ยอดสุทธิ</th>
                            <th>สถานะออเดอร์</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            var customerName = users?.FirstOrDefault(u => u.UserId == order.UserId)?.Username ?? "ไม่ทราบ";
                            <tr>
                                <td style="font-weight: bold; color: #4a3b8c;">#@(order.OrderId)</td>
                                <td style="font-size: 0.9rem;">@order.OrderDate</td>
                                <td>@customerName</td>
                                <td style="color: #38a169; font-weight: bold;">฿@order.TotalAmount</td>
                                <td><span style="background: #f0ebf8; color: #4a3b8c; padding: 4px 10px; border-radius: 12px; font-size: 0.85rem;">@order.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="manager-stat-icon mx-auto mb-3"><i class="fa-solid fa-inbox" aria-hidden="true"></i></div>
                <div class="fw-bold">ยังไม่มีคำสั่งซื้อเข้ามาในระบบ</div>
                <div class="text-muted small mt-1">รายการใหม่จะแสดงที่นี่เมื่อมีการสั่งซื้อ</div>
            </div>
        }
    </div>
</div>