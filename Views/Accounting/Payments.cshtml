@model Gamesgiftshop.Models.AccountingPaymentViewModel
@{
    Layout = "_AccountingLayout";
    ViewData["Title"] = "ตรวจสอบการชำระเงิน";
}

<div class="accounting-page-heading">
    <div class="accounting-page-icon"><i class="fa-solid fa-money-check-dollar" aria-hidden="true"></i></div>
    <div>
        <div class="accounting-eyebrow">PAYMENT REVIEW</div>
        <h1 class="h3 fw-bold mb-1">ตรวจสอบการชำระเงิน</h1>
        <p>ตรวจสอบสลิปและยืนยันหรือปฏิเสธการชำระเงินของลูกค้า</p>
    </div>
</div>

@if (TempData["PaymentReviewSuccess"] != null)
{
    <div class="alert alert-success">@TempData["PaymentReviewSuccess"]</div>
}
@if (TempData["PaymentReviewError"] != null)
{
    <div class="alert alert-danger">@TempData["PaymentReviewError"]</div>
}

<section class="accounting-card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h5 fw-bold mb-1">รายการรอตรวจสอบ</h2>
            <div class="small text-muted">ยืนยันได้เฉพาะออเดอร์ที่แนบสลิปแล้ว</div>
        </div>
        <span class="badge text-bg-warning">@Model.PendingCount รายการ</span>
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ออเดอร์ / วันที่</th>
                    <th>ลูกค้า</th>
                    <th>รายการสินค้า</th>
                    <th>ยอดชำระ</th>
                    <th>สลิป</th>
                    <th class="text-end">ผลตรวจสอบ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Any())
                {
                    foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">#@order.OrderId</div>
                                <div class="small text-muted">@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</div>
                                <span class="badge text-bg-light">@order.Status</span>
                            </td>
                            <td>@order.CustomerName</td>
                            <td>
                                @foreach (var product in order.ProductSummary)
                                {
                                    <div>@product</div>
                                }
                            </td>
                            <td class="amount-income">฿@order.TotalAmount.ToString("N2")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(order.PaymentSlipUrl))
                                {
                                    <a href="@order.PaymentSlipUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-regular fa-image me-1" aria-hidden="true"></i> ดูสลิป
                                    </a>
                                }
                                else
                                {
                                    <span class="small text-danger">ไม่มีสลิป</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(order.PaymentSlipUrl))
                                {
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-action="ReviewPayment" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <input type="hidden" name="approved" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fa-solid fa-check me-1" aria-hidden="true"></i> ยืนยัน
                                            </button>
                                        </form>
                                        <form asp-action="ReviewPayment" method="post"
                                              onsubmit="return confirm('ยืนยันปฏิเสธสลิปของออเดอร์ #@order.OrderId หรือไม่?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <input type="hidden" name="approved" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">ปฏิเสธ</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="small text-muted">รอลูกค้าแนบสลิป</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">ไม่มีรายการรอตรวจสอบ</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
