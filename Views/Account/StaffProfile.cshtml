@model Gamesgiftshop.Models.StaffProfileViewModel

@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" :
        User.IsInRole("Manager") ? "_ManagerLayout" :
        User.IsInRole("Staff") ? "_StaffLayout" :
        "_AccountingLayout";
    ViewData["Title"] = "ข้อมูลบัญชีพนักงาน";
    var initial = string.IsNullOrWhiteSpace(Model.Username)
        ? "U"
        : Model.Username.Substring(0, 1).ToUpper();
}

<section class="staff-profile-page">
    <div class="staff-profile-heading">
        <span class="staff-profile-heading-icon"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
        <div>
            <h1>ข้อมูลบัญชีพนักงาน</h1>
            <p>ข้อมูลบัญชีสำหรับการใช้งานระบบหลังบ้าน</p>
        </div>
    </div>

    <div class="staff-profile-card">
        <div class="staff-profile-summary">
            <div class="staff-profile-avatar" aria-hidden="true">@initial</div>
            <div>
                <h2>@Model.Username</h2>
                <span class="staff-profile-role">@Model.RoleName</span>
            </div>
        </div>

        <dl class="staff-profile-details">
            <div>
                <dt><i class="fa-solid fa-user" aria-hidden="true"></i> ชื่อผู้ใช้งาน</dt>
                <dd>@Model.Username</dd>
            </div>
            <div>
                <dt><i class="fa-solid fa-envelope" aria-hidden="true"></i> อีเมล</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "ยังไม่ได้ระบุอีเมล" : Model.Email)</dd>
            </div>
            <div>
                <dt><i class="fa-solid fa-phone" aria-hidden="true"></i> เบอร์โทรศัพท์</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "ยังไม่ได้ระบุเบอร์โทรศัพท์" : Model.Phone)</dd>
            </div>
            <div>
                <dt><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> สิทธิ์การใช้งาน</dt>
                <dd>@Model.RoleName</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .staff-profile-page { max-width: 900px; margin: 0 auto; color: #1e293b; }
    .staff-profile-heading { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
    .staff-profile-heading-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: #eaf1ff; color: #1d67d6; font-size: 1.25rem; }
    .staff-profile-heading h1 { margin: 0; font-size: 1.5rem; font-weight: 750; }
    .staff-profile-heading p { margin: 5px 0 0; color: #64748b; }
    .staff-profile-card { padding: 28px; border: 1px solid #e2e8f0; border-radius: 18px; background: #fff; box-shadow: 0 8px 24px rgba(15, 23, 42, .05); }
    .staff-profile-summary { display: flex; align-items: center; gap: 16px; padding-bottom: 24px; border-bottom: 1px solid #e2e8f0; }
    .staff-profile-avatar { display: grid; place-items: center; width: 64px; height: 64px; flex: 0 0 64px; border-radius: 50%; background: linear-gradient(135deg, #64748b, #334155); color: #fff; font-size: 1.6rem; font-weight: 800; }
    .staff-profile-summary h2 { margin: 0 0 7px; font-size: 1.2rem; font-weight: 750; }
    .staff-profile-role { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #f1f5f9; color: #475569; font-size: .82rem; font-weight: 650; }
    .staff-profile-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 28px; margin: 24px 0 0; }
    .staff-profile-details div { min-width: 0; }
    .staff-profile-details dt { margin-bottom: 7px; color: #64748b; font-size: .86rem; font-weight: 650; }
    .staff-profile-details dt i { width: 18px; margin-right: 5px; }
    .staff-profile-details dd { margin: 0; color: #1e293b; font-weight: 600; overflow-wrap: anywhere; }
    @@media (max-width: 575.98px) {
        .staff-profile-card { padding: 20px; }
        .staff-profile-details { grid-template-columns: 1fr; gap: 18px; }
    }
</style>
