@model IEnumerable<Gamesgiftshop.Models.Order>

@{
    ViewData["Title"] = "โปรไฟล์ของฉัน - Games Gift Shop";
    
    var displayName = User.Identity?.Name ?? "Member";
    var initial = string.IsNullOrEmpty(displayName) ? "U" : displayName.Substring(0, 1).ToUpper();
    var emailClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email);
    var userEmail = emailClaim != null && !string.IsNullOrEmpty(emailClaim.Value) ? emailClaim.Value : "ยังไม่ได้ระบุอีเมล";

    // รับค่าเบอร์โทรและที่อยู่มาจาก Controller
    var phone = ViewBag.Phone as string;
    var displayPhone = string.IsNullOrEmpty(phone) ? "ยังไม่ได้ระบุเบอร์โทรศัพท์" : phone;
    var addresses = ViewBag.Addresses as List<Gamesgiftshop.Models.Useraddress>;
    var favoriteProducts = ViewBag.FavoriteProducts as List<Gamesgiftshop.Models.Product>
        ?? new List<Gamesgiftshop.Models.Product>();
    var refundRequests = ViewBag.RefundRequests as List<Gamesgiftshop.Models.RefundRequest>
        ?? new List<Gamesgiftshop.Models.RefundRequest>();
    var showOrdersPanel = Context.Request.Query["panel"].ToString() == "orders-panel";
}

<style>
    /* ================= ธีม Modern Minimalist ================= */
    body { background-color: #0f1115; color: #e2e8f0; }
    .profile-container { max-width: 1200px; margin: 40px auto; padding: 0 15px; }
    .profile-card { background: #16181f; border: 1px solid #222631; border-radius: 16px; padding: 35px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); }
    .profile-sidebar {
        position: sticky;
        top: 100px;
        padding: 12px;
        background: #fff;
        border: 1px solid #dce8f5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(32, 75, 125, .06);
    }
    .profile-nav-item {
        display: flex;
        width: 100%;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 12px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: #496683;
        text-align: left;
        transition: background .2s ease, color .2s ease;
    }
    .profile-nav-item i { width: 18px; margin-top: 3px; color: #8095ab; text-align: center; }
    .profile-nav-item small { display: block; margin-top: 2px; color: #8498ad; font-size: .75rem; }
    .profile-nav-item:hover,
    .profile-nav-item.active { background: #edf5ff; color: #173a61; }
    .profile-nav-item.active i { color: #1d67d6; }
    .profile-panel[hidden] { display: none !important; }
    .favorite-product-info { flex: 1 1 0; min-width: 0; }
    .favorite-product-name { display: block; white-space: normal; overflow-wrap: anywhere; }
    .refund-request-box {
        padding: 14px;
        border: 1px solid #d5e5f6;
        border-radius: 12px;
        background: #f0f7ff;
        color: #345575;
    }
    .refund-request-toggle { padding: 0; overflow: hidden; }
    .refund-request-toggle summary {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        color: #1955a5;
        font-weight: 600;
        cursor: pointer;
        list-style: none;
    }
    .refund-request-toggle summary::-webkit-details-marker { display: none; }
    .refund-request-toggle summary:hover { background: #e5f1ff; }
    .refund-request-toggle summary:focus-visible { outline: 2px solid #2563eb; outline-offset: -3px; }
    .refund-request-icon {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #dcecff;
        color: #2164bc;
    }
    .refund-request-heading { flex: 1; min-width: 0; }
    .refund-request-heading small { display: block; color: #617d9a; font-size: .8rem; font-weight: 400; }
    .refund-request-chevron { transition: transform .2s ease; }
    .refund-request-toggle[open] .refund-request-chevron { transform: rotate(180deg); }
    .refund-request-form { padding: 0 16px 16px; }
    .refund-request-form label { color: #345575; font-weight: 600; }
    .refund-request-form .refund-request-submit {
        background: #1d67d6;
        border-color: #1d67d6;
        color: #fff;
    }
    .refund-request-form .refund-request-submit:hover {
        background: #1555b5;
        border-color: #1555b5;
        color: #fff;
    }
    .profile-header { display: flex; align-items: center; gap: 20px; margin-bottom: 30px; padding-bottom: 25px; border-bottom: 1px solid #222631; }
    
    .profile-avatar { width: 90px; height: 90px; border-radius: 50%; background-color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; color: white; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3); }
    .loyalty-box { background: #222631; border: 1px solid transparent; border-radius: 12px; padding: 15px 25px; text-align: center; min-width: 150px; }
    .loyalty-points { font-size: 1.8rem; font-weight: 800; color: #6366f1; }
    
    .section-title { font-size: 1.1rem; font-weight: 700; color: #ffffff; margin-bottom: 20px; }
    .text-label { color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 5px; display: block; }
    .text-value { color: #f1f5f9; font-size: 0.95rem; font-weight: 500; }
    .action-link { color: #6366f1; text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: 0.2s; }
    .action-link:hover { color: #818cf8; text-decoration: underline; }
    
    .info-box { background: #222631; border: 1px solid transparent; border-radius: 12px; padding: 20px 25px; margin-bottom: 30px; }
    .info-row { display: flex; margin-bottom: 12px; }
    .info-row:last-child { margin-bottom: 0; }
    .info-row .text-label { width: 130px; flex-shrink: 0; margin-bottom: 0; }
    
    /* กล่องที่อยู่ */
    .address-card-shopee { background: #1a1d24; border: 1px solid #222631; border-radius: 12px; padding: 20px; margin-bottom: 15px; transition: 0.2s; }
    .address-card-shopee:hover { border-color: #6366f1; background: #222631; }
    .addr-name { font-size: 1.15rem; font-weight: 700; color: #ffffff; }
    .addr-phone { font-size: 0.9rem; color: #94a3b8; border-left: 1px solid #4b5563; margin-left: 12px; padding-left: 12px; }
    .addr-detail { color: #cbd5e1; font-size: 0.95rem; margin-top: 10px; line-height: 1.6; white-space: pre-line; }
    .badge-default { background: #6366f1; color: white; border: none; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; }
    
    /* ปุ่ม Radio ติ๊กเลือกที่อยู่ */
    .form-check-input { background-color: #222631; border-color: #4b5563; cursor: pointer; }
    .form-check-input:checked { background-color: #6366f1; border-color: #6366f1; }

    .btn-add-address { background: transparent; border: 1px dashed #6366f1; color: #818cf8; border-radius: 12px; padding: 15px; width: 100%; font-weight: bold; transition: 0.2s; cursor: pointer; text-align: center; margin-bottom: 20px; }
    .btn-add-address:hover { background: rgba(99, 102, 241, 0.1); color: #ffffff; }
    .form-control-custom { background-color: #0f1115 !important; border: 1px solid #334155 !important; color: #ffffff !important; padding: 10px 15px; border-radius: 8px; transition: 0.2s; }
    .form-control-custom::placeholder { color: #64748b !important; }
    .form-control-custom:focus { border-color: #6366f1 !important; box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25) !important; }
    
    .btn-save { background-color: #6366f1; color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; transition: 0.2s; }
    .btn-save:hover { background-color: #4f46e5; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); color: white; }
    .btn-cancel { background: transparent; color: #94a3b8; border: 1px solid #334155; border-radius: 8px; padding: 12px; font-weight: 600; transition: 0.2s; }
    .btn-cancel:hover { background: #334155; color: white; }
    
    /* ⭐️ ประวัติคำสั่งซื้อและป้ายสถานะ ⭐️ */
    .history-card { background: #1a1d24; border: 1px solid #222631; border-radius: 12px; padding: 20px; margin-bottom: 15px; transition: 0.2s; }
    .history-card:hover { border-color: #6366f1; background: #222631; }
    
    .status-badge { 
        padding: 6px 14px; 
        border-radius: 8px; 
        font-size: 0.8rem; 
        font-weight: 700; 
        display: inline-block;
        white-space: nowrap;
    }
    
    .status-pending { 
        background: rgba(245, 158, 11, 0.15); 
        color: #fcd34d; 
        border: 1px solid rgba(245, 158, 11, 0.3); 
    }
    
    .status-completed { 
        background: rgba(16, 185, 129, 0.15); 
        color: #34d399; 
        border: 1px solid rgba(16, 185, 129, 0.3); 
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .status-cancelled {
        background: rgba(239, 68, 68, 0.15); 
        color: #fca5a5; 
        border: 1px solid rgba(239, 68, 68, 0.3); 
    }
    
    /* ================= ปุ่มออกจากระบบ (หน้า Profile) ================= */
    .btn-profile-logout { background: rgba(239, 68, 68, 0.05); color: #ef4444; border: 1px dashed rgba(239, 68, 68, 0.4); border-radius: 12px; padding: 12px; width: 100%; font-weight: bold; font-size: 0.95rem; transition: all 0.3s ease; text-decoration: none; display: inline-flex; justify-content: center; align-items: center; gap: 8px; margin-top: 25px; }
    .btn-profile-logout:hover { background: #ef4444; border: 1px solid #ef4444; color: white; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3); transform: translateY(-2px); }
    @@media (max-width: 991.98px) {
        .profile-sidebar { position: static; display: flex; gap: 6px; overflow-x: auto; }
        .profile-nav-item { min-width: 150px; }
    }
</style>

<div class="container profile-container mb-5">
    @if (TempData["RefundRequestSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["RefundRequestSuccess"]</div>
    }
    @if (TempData["RefundRequestError"] != null)
    {
        <div class="alert alert-danger">@TempData["RefundRequestError"]</div>
    }

    <div class="row g-4">

        <aside class="col-lg-3">
            <nav class="profile-sidebar" aria-label="เมนูโปรไฟล์">
                <button type="button" class="profile-nav-item @(showOrdersPanel ? "" : "active")" data-profile-panel="profile-panel">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                    <span>โปรไฟล์<small>ข้อมูลส่วนตัวและที่อยู่</small></span>
                </button>
                <button type="button" class="profile-nav-item @(showOrdersPanel ? "active" : "")" data-profile-panel="orders-panel">
                    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                    <span>การซื้อ<small>ประวัติคำสั่งซื้อ</small></span>
                </button>
                <button type="button" class="profile-nav-item" data-profile-panel="favorites-panel">
                    <i class="fa-regular fa-heart" aria-hidden="true"></i>
                    <span>สินค้าที่ชอบ<small>รายการสินค้าที่บันทึกไว้</small></span>
                </button>
            </nav>
        </aside>

        <div class="col-lg-9">
            <section class="profile-panel" id="profile-panel" hidden="@((showOrdersPanel ? "hidden" : null))">
            <div class="profile-card h-100">
                
                <div class="profile-header d-flex flex-column flex-sm-row justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3 mb-3 mb-sm-0">
                        <div class="profile-avatar">@initial</div>
                        <div>
                            <h3 class="fw-bold text-white mb-1" style="font-size: 1.4rem;">@displayName</h3>
                            <span class="badge" style="background-color: #334155; font-size: 0.75rem; font-weight: 500;">สมาชิกระดับทั่วไป</span>
                        </div>

                    </div>
                    <div class="loyalty-box shadow-sm">
                        <div class="text-label mb-1" style="font-size: 0.75rem; color: #94a3b8;">Loyalty Points</div>
                        <div class="loyalty-points">@(ViewBag.LoyaltyPoints ?? 0)</div>
                        <div class="small text-secondary mt-1">ทุกยอดใช้จ่าย ฿100 รับ 1 แต้ม</div>
                    </div>
                </div>

                <!-- 🟢 โหมดแสดงข้อมูล -->
                <div id="view-mode">
                    <div class="d-flex justify-content-between align-items-end mb-3">
                        <div class="section-title mb-0">ข้อมูลส่วนตัว</div>
                        <a href="javascript:void(0)" onclick="toggleEditMode(true)" class="action-link">แก้ไขข้อมูล</a>
                    </div>

                    <div class="info-box">
                        <div class="info-row">
                            <div class="text-label" style="width: 130px;">ชื่อผู้ใช้งาน</div>
                            <div class="text-value">@displayName</div>
                        </div>
                        <div class="info-row">
                            <div class="text-label" style="width: 130px;">อีเมล</div>
                            <div class="text-value">@userEmail</div>
                        </div>
                        <div class="info-row">
                            <div class="text-label" style="width: 130px;">เบอร์โทรศัพท์</div>
                            <div class="text-value">@displayPhone</div>
                        </div>
                    </div>

                    <div class="section-title mt-4">ที่อยู่จัดส่งสินค้า</div>
                    
                    @if (addresses != null && addresses.Count > 0)
                    {
                        var sortedAddresses = addresses.OrderByDescending(a => a.IsDefault).ToList();
                        int count = 1;
                        foreach (var addr in sortedAddresses)
                        {
                            // ⭐️ ระบบแกะข้อมูลที่แยกเก็บไว้ (ชื่อ | เบอร์ | ที่อยู่) ให้ยืดหยุ่น ⭐️
                            string savedName = displayName;
                            string savedPhone = displayPhone;
                            string savedAddr = addr.AddressDetail ?? "";

                            if (savedAddr.Contains("ชื่อ:") && savedAddr.Contains("โทร:") && savedAddr.Contains("ที่อยู่:"))
                            {
                                var parts = savedAddr.Split('|');
                                if (parts.Length >= 3)
                                {
                                    savedName = parts[0].Replace("ชื่อ:", "").Trim();
                                    savedPhone = parts[1].Replace("โทร:", "").Trim();
                                    savedAddr = parts[2].Replace("ที่อยู่:", "").Trim();
                                }
                            }

                            <div class="address-card-shopee">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div style="display: flex; align-items: baseline;">
                                        <span class="addr-name">@savedName</span>
                                        @if(!string.IsNullOrEmpty(savedPhone))
                                        {
                                            <span class="addr-phone"><i class="fa-solid fa-phone" style="font-size: 0.8rem; margin-right: 4px;"></i>@savedPhone</span>
                                        }
                                    </div>
                                    <div class="addr-actions">
                                        <a href="javascript:void(0)" onclick="toggleEditMode(true)" class="action-link">แก้ไข</a>
                                    </div>
                                </div>
                                <div class="addr-detail">
                                    @savedAddr
                                </div>
                                
                                @if (addr.IsDefault == true || (count == 1 && sortedAddresses.All(a => a.IsDefault != true)))
                                {
                                    <div class="mt-3">
                                        <span class="badge-default">ค่าเริ่มต้น</span>
                                    </div>
                                }
                            </div>
                            count++;
                        }
                    }
                    else
                    {
                        <div class="info-box text-muted text-center" style="font-size: 0.9rem;">
                            ยังไม่มีข้อมูลที่อยู่จัดส่ง กรุณากด "แก้ไขข้อมูล" เพื่อเพิ่มที่อยู่
                        </div>
                    }

                    <a href="/Account/Logout" class="btn-profile-logout">
                        <i class="fa-solid fa-power-off"></i> ออกจากระบบ
                    </a>
                </div>

                <!-- 🟠 โหมดแก้ไขข้อมูล -->
                <div id="edit-mode" style="display: none;">
                    <div class="section-title" style="color: #ffffff; font-size: 1.3rem;">แก้ไขโปรไฟล์และที่อยู่</div>
                    
                    <!-- ⭐️ สั่งให้รัน JS (prepareAddressesBeforeSubmit) ก่อนส่งฟอร์ม ⭐️ -->
                    <form method="post" action="/Account/EditProfile" onsubmit="return prepareAddressesBeforeSubmit()">
                        <div class="mb-3">
                            <label class="text-label">ชื่อผู้ใช้งาน (Username)</label>
                            <input type="text" name="username" class="form-control form-control-custom" value="@displayName" required>
                        </div>
                        <div class="mb-4">
                            <label class="text-label">เบอร์โทรศัพท์บัญชีหลัก</label>
                            <input type="tel" name="phone" class="form-control form-control-custom" placeholder="เช่น 0987654321" value="@phone">
                        </div>

                        <hr style="border-color: #334155; margin: 35px 0;">
                        <div class="section-title">จัดการที่อยู่จัดส่ง</div>

                        <div id="address-fields-container">
                            @if (addresses != null && addresses.Count > 0)
                            {
                                int editCount = 0;
                                foreach (var addr in addresses)
                                {
                                    bool isDef = addr.IsDefault == true || (editCount == 0 && !addresses.Any(a => a.IsDefault == true));
                                    
                                    // ⭐️ แกะข้อมูลสำหรับช่อง Input แยกกัน ⭐️
                                    string editName = displayName;
                                    string editPhone = displayPhone;
                                    string editAddr = addr.AddressDetail ?? "";
                                    
                                    if (editAddr.Contains("ชื่อ:") && editAddr.Contains("โทร:") && editAddr.Contains("ที่อยู่:"))
                                    {
                                        var parts = editAddr.Split('|');
                                        if (parts.Length >= 3)
                                        {
                                            editName = parts[0].Replace("ชื่อ:", "").Trim();
                                            editPhone = parts[1].Replace("โทร:", "").Trim();
                                            editAddr = parts[2].Replace("ที่อยู่:", "").Trim();
                                        }
                                    }

                                    <div class="address-card-shopee address-item mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="form-check m-0">
                                                <input class="form-check-input default-addr-radio" type="radio" name="DefaultAddressIndex" value="@editCount" id="defAddr_@editCount" @(isDef ? "checked" : "")>
                                                <label class="form-check-label text-label mb-0" for="defAddr_@editCount" style="cursor: pointer; color: #818cf8;">ตั้งเป็นที่อยู่หลัก</label>
                                            </div>
                                            @if (editCount > 0)
                                            {
                                                <a href="javascript:void(0)" class="text-danger" style="text-decoration: none; font-size: 0.85rem;" onclick="removeAddressItem(this)">ลบที่อยู่นี้</a>
                                            }
                                        </div>
                                        
                                        <!-- ช่องกรอกข้อมูล 3 ช่อง -->
                                        <div class="mb-2">
                                            <label class="text-label" style="font-size:0.75rem;">ชื่อ-นามสกุลผู้รับ</label>
                                            <input type="text" class="form-control form-control-custom input-addr-name" value="@editName" placeholder="ระบุชื่อผู้รับ..." required>
                                        </div>
                                        <div class="mb-2">
                                            <label class="text-label" style="font-size:0.75rem;">เบอร์โทรศัพท์ติดต่อ</label>
                                            <input type="tel" class="form-control form-control-custom input-addr-phone" value="@editPhone" placeholder="ระบุเบอร์โทรศัพท์..." required>
                                        </div>
                                        <div class="mb-0">
                                            <label class="text-label" style="font-size:0.75rem;">รายละเอียดที่อยู่</label>
                                            <textarea class="form-control form-control-custom input-addr-detail" rows="2" placeholder="บ้านเลขที่, ซอย, ถนน, ตำบล..." required>@editAddr</textarea>
                                        </div>
                                        
                                        <!-- Input ซ่อนที่จะรับข้อมูลรวมกันเพื่อส่งกลับไป Controller -->
                                        <input type="hidden" name="Addresses" class="input-real-addr" value="@addr.AddressDetail" />
                                    </div>
                                    editCount++;
                                }
                            }
                            else
                            {
                                <div class="address-card-shopee address-item mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="form-check m-0">
                                            <input class="form-check-input default-addr-radio" type="radio" name="DefaultAddressIndex" value="0" id="defAddr_0" checked>
                                            <label class="form-check-label text-label mb-0" for="defAddr_0" style="cursor: pointer; color: #818cf8;">ตั้งเป็นที่อยู่หลัก</label>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-label" style="font-size:0.75rem;">ชื่อ-นามสกุลผู้รับ</label>
                                        <input type="text" class="form-control form-control-custom input-addr-name" value="@displayName" placeholder="ระบุชื่อผู้รับ..." required>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-label" style="font-size:0.75rem;">เบอร์โทรศัพท์ติดต่อ</label>
                                        <input type="tel" class="form-control form-control-custom input-addr-phone" value="@phone" placeholder="ระบุเบอร์โทรศัพท์..." required>
                                    </div>
                                    <div class="mb-0">
                                        <label class="text-label" style="font-size:0.75rem;">รายละเอียดที่อยู่</label>
                                        <textarea class="form-control form-control-custom input-addr-detail" rows="2" placeholder="บ้านเลขที่, ซอย, ถนน, ตำบล..." required></textarea>
                                    </div>
                                    <input type="hidden" name="Addresses" class="input-real-addr" value="" />
                                </div>
                            }
                        </div>

                        <button type="button" class="btn-add-address mt-2" onclick="addAddressField()">
                            <i class="fa-solid fa-plus"></i> เพิ่มที่อยู่ใหม่
                        </button>

                        <div class="d-flex gap-3 mt-4">
                            <button type="button" class="btn btn-cancel w-50" onclick="toggleEditMode(false)">ยกเลิก</button>
                            <button type="submit" class="btn btn-save w-50">บันทึกข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>
            </section>

            <section class="profile-panel" id="orders-panel" hidden="@((showOrdersPanel ? null : "hidden"))">
            <div class="profile-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="section-title mb-0">ประวัติคำสั่งซื้อ</div>
                </div>
                
                @if (Model != null && Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        var orderRefunds = refundRequests
                            .Where(request => request.OrderId == order.OrderId)
                            .OrderByDescending(request => request.RequestedAt)
                            .ToList();
                        var hasPendingOrCompletedRefund = orderRefunds.Any(request =>
                            request.Status != Gamesgiftshop.Models.RefundRequest.RejectedStatus);
                        var canRequestRefund = !hasPendingOrCompletedRefund &&
                            (order.Status == "ชำระเงินสำเร็จแล้ว" ||
                             order.Status == "เตรียมจัดส่ง" ||
                             order.Status == "จัดส่งแล้ว" ||
                             order.Status == "สำเร็จ") &&
                            order.OrderDate.HasValue &&
                            order.OrderDate.Value >= DateTime.Now.AddDays(-7) &&
                            order.OrderDate.Value <= DateTime.Now;
                        <div class="history-card">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-2 gap-3">
                                <div style="flex-grow: 1; min-width: 0; padding-right: 15px;">
                                    <div class="fw-bold mb-1" style="font-size: 1.05rem; color: #ffffff;">คำสั่งซื้อ #@(order.OrderId.ToString("D4"))</div>
                                    <div class="text-label mt-1">
                                        วันที่สั่งซื้อ: @(order.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                    <div class="text-label mt-1" style="font-size: 0.85rem; line-height: 1.5; word-break: break-word;">
                                        ที่อยู่จัดส่ง: @order.ShippingAddress
                                    </div>
                                </div>
                                <div class="text-end" style="flex-shrink: 0; min-width: 120px;">
                                    <span class="status-badge @(order.Status == "ชำระเงินสำเร็จแล้ว" || order.Status == "สำเร็จ" || order.Status == "จัดส่งแล้ว" ? "status-completed" : order.Status == "ชำระเงินไม่ผ่าน" || order.Status == "คืนเงินแล้ว" ? "status-rejected" : "status-pending")">
                                        @order.Status
                                    </span>
                                    @if (order.Status == "ชำระเงินไม่ผ่าน")
                                    {
                                        <div class="small text-danger mt-2">กรุณาติดต่อร้านค้าเพื่อดำเนินการชำระเงินอีกครั้ง</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.TrackingNumber))
                                    {
                                        <div class="small text-light mt-2">เลขติดตามพัสดุ: @order.TrackingNumber</div>
                                    }
                                    <div class="fw-bold mt-2" style="color: #6366f1; font-size: 1.1rem;">
                                        ฿@order.TotalAmount.ToString("N0")
                                    </div>
                                </div>
                            </div>

                            <!-- ⭐️ ส่วนแสดงรายการสินค้า ⭐️ -->
                            @if (order.Orderdetails != null && order.Orderdetails.Any())
                            {
                                <div class="mt-3 pt-3" style="border-top: 1px dashed #334155;">
                                    <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 10px; font-weight: 600;">
                                        รายการสินค้าในคำสั่งซื้อ:
                                    </div>
                                    
                                    @foreach (var detail in order.Orderdetails)
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.9rem; color: #cbd5e1;">
                                            <div class="d-flex align-items-center gap-2 text-truncate" style="padding-right: 15px;">
                                                <!-- ไอคอนจอยเกม (เปลี่ยนได้ตามต้องการ) -->
                                                <i class="fa-solid fa-gamepad" style="color: #475569; font-size: 0.8rem;"></i>
                                                
                                                <!-- โชว์ชื่อสินค้า -->
                                                <span class="text-truncate">
                                                    @(detail.Product != null ? detail.Product.Name : "สินค้า ID: " + detail.ProductId)
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(detail.Size))
                                                {
                                                    <span class="small">ไซซ์ @detail.Size</span>
                                                }
                                                
                                                <!-- จำนวนชิ้น -->
                                                <span style="color: #6366f1; font-weight: 700; font-size: 0.85rem; background: rgba(99,102,241,0.1); padding: 2px 6px; border-radius: 4px;">
                                                    x@(detail.Quantity)
                                                </span>
                                            </div>
                                            
                                            <!-- ราคาของสินค้านั้นๆ (ราคา * จำนวนชิ้น) -->
                                            <div style="color: #94a3b8; white-space: nowrap;">
                                                ฿@((detail.Price * detail.Quantity).ToString("N0") ?? "0")
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="mt-3 pt-2 text-muted" style="border-top: 1px dashed #334155; font-size: 0.85rem;">
                                    (ไม่พบรายละเอียดสินค้า)
                                </div>
                            }

                            @if (orderRefunds.Any())
                            {
                                <div class="refund-request-box mt-3">
                                    @foreach (var request in orderRefunds)
                                    {
                                        <div class="mb-2">
                                            <strong>คำขอคืนเงิน: @request.Status</strong>
                                            <div class="small text-muted">ส่งคำขอเมื่อ @request.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            <div class="small mt-1">เหตุผล: @request.Reason</div>
                                            @if (!string.IsNullOrWhiteSpace(request.Feedback))
                                            {
                                                <div class="small mt-1">Feedback จากบัญชี: @request.Feedback</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(request.ReturnAddress))
                                            {
                                                <div class="small mt-1" style="white-space: pre-line"><strong>ที่อยู่ส่งคืน:</strong> @request.ReturnAddress</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(request.ReturnTrackingNumber))
                                            {
                                                <div class="small mt-1"><strong>เลขพัสดุส่งคืน:</strong> @request.ReturnTrackingNumber</div>
                                            }
                                            @if (request.Status == Gamesgiftshop.Models.RefundRequest.AwaitingReturnStatus)
                                            {
                                                <form asp-action="SubmitReturnTracking" method="post" class="mt-3">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@request.RefundRequestId" />
                                                    <label class="form-label" for="return-tracking-@request.RefundRequestId">เลขพัสดุส่งคืน</label>
                                                    <input class="form-control form-control-custom mb-2" id="return-tracking-@request.RefundRequestId"
                                                           name="trackingNumber" maxlength="100" required />
                                                    <button class="btn btn-primary btn-sm" type="submit">แจ้งเลขพัสดุ</button>
                                                </form>
                                            }
                                            @if (request.Status == Gamesgiftshop.Models.RefundRequest.RefundedStatus)
                                            {
                                                <a class="btn btn-outline-warning btn-sm mt-2"
                                                   asp-controller="Account"
                                                   asp-action="RefundReceipt"
                                                   asp-route-id="@request.RefundRequestId">
                                                    <i class="fa-solid fa-file-pdf me-1" aria-hidden="true"></i> ดาวน์โหลดใบเสร็จคืนเงิน
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (canRequestRefund)
                            {
                                <details class="refund-request-box refund-request-toggle mt-3">
                                    <summary>
                                        <span class="refund-request-icon"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></span>
                                        <span class="refund-request-heading">
                                            ขอคืนเงินภายใน 7 วัน
                                            <small>แจ้งเหตุผลเพื่อให้ฝ่ายบัญชีตรวจสอบ</small>
                                        </span>
                                        <i class="fa-solid fa-chevron-down refund-request-chevron" aria-hidden="true"></i>
                                    </summary>
                                    <form asp-action="RequestRefund" method="post" enctype="multipart/form-data" class="refund-request-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <p class="small mb-3">เตรียมรูปหลักฐาน → ส่งคำขอภายใน 7 วันนับจากวันสั่งซื้อ → ส่งคืนสินค้าหากฝ่ายบัญชีแจ้ง → รอตรวจสอบและรับเงินคืน</p>
                                        <label class="form-label" for="refund-reason-@order.OrderId">เหตุผลการขอคืนเงิน</label>
                                        <textarea class="form-control form-control-custom mb-3"
                                                  id="refund-reason-@order.OrderId" name="reason"
                                                  minlength="5" maxlength="1000" required rows="3"
                                                  placeholder="กรุณาระบุเหตุผลอย่างน้อย 5 ตัวอักษร"></textarea>
                                        <label class="form-label" for="refund-evidence-@order.OrderId">รูปหลักฐาน (JPEG หรือ PNG ไม่เกิน 5 MB)</label>
                                        <input class="form-control form-control-custom mb-3" id="refund-evidence-@order.OrderId"
                                               type="file" name="evidence" accept="image/jpeg,image/png" required />
                                        <button type="submit" class="btn refund-request-submit btn-sm">
                                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i> ส่งคำขอคืนเงิน
                                        </button>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5" style="background: #222631; border-radius: 12px;">
                        <span style="color: #64748b;">คุณยังไม่มีประวัติการสั่งซื้อ</span>
                    </div>
                }
            </div>
            </section>

            <section class="profile-panel" id="favorites-panel" hidden>
            <div class="profile-card">
        <div class="section-title">สินค้าที่ชอบ</div>
        @if (favoriteProducts.Any())
        {
            <div class="row g-3">
                @foreach (var product in favoriteProducts)
                {
                    <div class="col-md-6">
                        <div class="history-card h-100 mb-0">
                            <div class="d-flex align-items-center gap-3">
                                <a href="/Product/Details/@product.ProductId" class="flex-shrink-0">
                                    <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? "https://via.placeholder.com/100?text=No+Image" : product.ImageUrl.Split(',')[0])"
                                         alt="@product.Name"
                                         style="width: 76px; height: 76px; object-fit: cover; border-radius: 10px;">
                                </a>
                                <div class="favorite-product-info">
                                    <a href="/Product/Details/@product.ProductId" class="text-decoration-none fw-bold favorite-product-name">
                                        @product.Name
                                    </a>
                                    <div class="fw-bold mt-1" style="color: #1d67d6;">฿@product.Price.ToString("N0")</div>
                                    <form asp-controller="Account" asp-action="ToggleFavorite" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.ProductId" />
                                        <input type="hidden" name="returnUrl" value="/Account/Profile" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-heart me-1" aria-hidden="true"></i> เลิกชอบ
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted">ยังไม่มีสินค้าที่ชอบ กดหัวใจบนสินค้าที่ต้องการบันทึกได้เลย</div>
        }
            </div>
    </section>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll(".profile-nav-item").forEach(button => {
        button.addEventListener("click", () => {
            const target = document.getElementById(button.dataset.profilePanel);
            if (!target) return;

            document.querySelectorAll(".profile-nav-item").forEach(item => item.classList.remove("active"));
            document.querySelectorAll(".profile-panel").forEach(panel => panel.hidden = true);
            button.classList.add("active");
            target.hidden = false;
        });
    });

    function toggleEditMode(isEditing) {
        const viewMode = document.getElementById('view-mode');
        const editMode = document.getElementById('edit-mode');
        if (isEditing) {
            viewMode.style.display = 'none';
            editMode.style.display = 'block';
        } else {
            viewMode.style.display = 'block';
            editMode.style.display = 'none';
        }
    }

    function updateAddressIndices() {
        const items = document.querySelectorAll('.address-item');
        items.forEach((item, index) => {
            const radio = item.querySelector('.default-addr-radio');
            if (radio) {
                radio.value = index;
                radio.id = 'defAddr_' + index;
                const label = item.querySelector('.form-check-label');
                if (label) label.setAttribute('for', 'defAddr_' + index);
            }
        });
    }

    function addAddressField() {
        const container = document.getElementById('address-fields-container');
        const index = container.querySelectorAll('.address-item').length;
        
        // ดึงชื่อและเบอร์โทรที่หน้าเว็บปัจจุบันมาตั้งเป็นค่าเริ่มต้น
        const currentName = "@displayName";
        const currentPhone = "@(phone ?? "")";

        const div = document.createElement('div');
        div.className = 'address-card-shopee address-item mt-3';
        div.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check m-0">
                    <input class="form-check-input default-addr-radio" type="radio" name="DefaultAddressIndex" value="${index}" id="defAddr_${index}">
                    <label class="form-check-label text-label mb-0" for="defAddr_${index}" style="cursor: pointer; color: #818cf8;">ตั้งเป็นที่อยู่หลัก</label>
                </div>
                <a href="javascript:void(0)" class="text-danger" style="text-decoration: none; font-size: 0.85rem;" onclick="removeAddressItem(this)">ลบที่อยู่นี้</a>
            </div>
            <div class="mb-2">
                <label class="text-label" style="font-size:0.75rem;">ชื่อ-นามสกุลผู้รับ</label>
                <input type="text" class="form-control form-control-custom input-addr-name" value="${currentName}" placeholder="ระบุชื่อผู้รับ..." required>
            </div>
            <div class="mb-2">
                <label class="text-label" style="font-size:0.75rem;">เบอร์โทรศัพท์ติดต่อ</label>
                <input type="tel" class="form-control form-control-custom input-addr-phone" value="${currentPhone}" placeholder="ระบุเบอร์โทรศัพท์..." required>
            </div>
            <div class="mb-0">
                <label class="text-label" style="font-size:0.75rem;">รายละเอียดที่อยู่</label>
                <textarea class="form-control form-control-custom input-addr-detail" rows="2" placeholder="บ้านเลขที่, ซอย, ถนน, ตำบล..." required></textarea>
            </div>
            <input type="hidden" name="Addresses" class="input-real-addr" value="" />
        `;
        container.appendChild(div);
        updateAddressIndices();
    }

    function removeAddressItem(btn) {
        const item = btn.closest('.address-item');
        const radio = item.querySelector('.default-addr-radio');
        const wasChecked = radio && radio.checked; 
        
        item.remove();
        updateAddressIndices();
        
        if (wasChecked) {
            const firstRadio = document.querySelector('.default-addr-radio');
            if (firstRadio) firstRadio.checked = true;
        }
    }

    // ⭐️ นำ 3 ช่องมารวมร่างกันก่อนกดบันทึก ⭐️
    function prepareAddressesBeforeSubmit() {
        const items = document.querySelectorAll('.address-item');
        items.forEach(item => {
            const name = item.querySelector('.input-addr-name').value.trim();
            const phone = item.querySelector('.input-addr-phone').value.trim();
            const detail = item.querySelector('.input-addr-detail').value.trim();
            
            // นำมาต่อกัน เช่น ชื่อ: นนท์ | โทร: 098... | ที่อยู่: 123/4...
            const combined = `ชื่อ: ${name} | โทร: ${phone} | ที่อยู่: ${detail}`;
            
            // ยัดใส่ Input ซ่อนเพื่อส่งไป C# Controller
            item.querySelector('.input-real-addr').value = combined;
        });
        return true; // อนุญาตให้ Form ส่งข้อมูลต่อไปได้
    }
</script>