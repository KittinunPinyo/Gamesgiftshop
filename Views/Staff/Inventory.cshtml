@model IEnumerable<Gamesgiftshop.Models.Product>
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "รับสินค้าเข้าคลัง";
    var products = Model?.ToList() ?? new List<Gamesgiftshop.Models.Product>();
    var outOfStockCount = products.Count(product => (product.StockQuantity ?? 0) <= 0);
    var stockUnits = products.Sum(product => (long)Math.Max(0, product.StockQuantity ?? 0));
}

<div class="staff-page-heading">
    <div class="staff-page-icon"><i class="fa-solid fa-warehouse" aria-hidden="true"></i></div>
    <div>
        <div class="staff-eyebrow">INVENTORY CONTROL</div>
        <h1>รับสินค้าเข้าคลัง</h1>
        <p>ค้นหาสินค้าและบันทึกจำนวนที่รับเข้าเพื่ออัปเดตสต็อก</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="staff-stat-card">
            <div class="staff-stat-icon"><i class="fa-solid fa-cubes-stacked" aria-hidden="true"></i></div>
            <div>
                <div class="staff-stat-label">สินค้าที่แสดง</div>
                <div class="staff-stat-value">@products.Count.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="staff-stat-card">
            <div class="staff-stat-icon"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></div>
            <div>
                <div class="staff-stat-label">จำนวนคงเหลือรวม</div>
                <div class="staff-stat-value">@stockUnits.ToString("N0") ชิ้น</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="staff-stat-card">
            <div class="staff-stat-icon"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></div>
            <div>
                <div class="staff-stat-label">สินค้าหมดสต็อก</div>
                <div class="staff-stat-value">@outOfStockCount.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

@if (TempData["InventoryError"] != null)
{
    <div class="alert alert-danger">@TempData["InventoryError"]</div>
}
@if (TempData["InventorySuccess"] != null)
{
    <div class="alert alert-success">@TempData["InventorySuccess"]</div>
}

<section class="staff-filter-card card mb-4">
    <div class="card-body p-4">
        <form asp-action="Inventory" method="get" class="row g-2">
            <div class="col-sm">
                <label class="visually-hidden" for="search">ค้นหาสินค้า</label>
                <input class="form-control" id="search" name="search" value="@ViewBag.Search" placeholder="ค้นหาชื่อสินค้า" />
            </div>
            <div class="col-sm-auto"><button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass me-1"></i>ค้นหา</button></div>
        </form>
    </div>
</section>

<section class="staff-inventory-card card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">สินค้า</th>
                    <th>สต็อกปัจจุบัน</th>
                    <th style="min-width: 300px">รับสินค้าเข้า</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-semibold">@product.Name</div>
                            <div class="small text-muted">รหัสสินค้า #@product.ProductId</div>
                        </td>
                        <td><span class="badge text-bg-secondary">@(product.StockQuantity ?? 0) ชิ้น</span></td>
                        <td>
                            <form asp-action="AddInventory" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <input type="hidden" name="search" value="@ViewBag.Search" />
                                <label class="visually-hidden" for="quantity-@product.ProductId">จำนวนที่รับเข้า</label>
                                <input class="form-control" type="number" id="quantity-@product.ProductId" name="quantity" min="1" required placeholder="จำนวน" />
                                <button type="submit" class="btn btn-success text-nowrap"><i class="fa-solid fa-plus me-1"></i>เพิ่มสต็อก</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!products.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-5">ไม่พบสินค้า</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
