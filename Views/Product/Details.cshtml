@model Gamesgiftshop.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Games Gift Shop";
    
    // คำนวณส่วนลด (ถ้ามี)
    double discountPct = 0;
    if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
    {
        discountPct = Math.Round((1 - (Convert.ToDouble(Model.Price) / Convert.ToDouble(Model.OriginalPrice.Value))) * 100);
    }

    // ตรวจสอบสต็อก
    bool requiresClothingSize = ViewBag.RequiresClothingSize == true;
    bool isFavorite = ViewBag.IsFavorite == true;
    var clothingSizeStocks = ViewBag.SizeStocks as Dictionary<string, int> ?? new Dictionary<string, int>();
    var availableStock = requiresClothingSize
        ? clothingSizeStocks.Values.Sum()
        : Model.StockQuantity ?? 0;
    bool inStock = availableStock > 0;
    var favoriteReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var clothingSizes = Gamesgiftshop.Models.ProductSizeStock.AvailableSizes;
    
    var imageUrls = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        // แตกข้อความด้วยลูกน้ำ (,) และกรองช่องว่างทิ้ง
        imageUrls = Model.ImageUrl.Split(',').Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
    }
    
    // ถ้าไม่มีรูปเลยในระบบ ให้ใช้รูป Default
    if (imageUrls.Count == 0)
    {
        imageUrls.Add("https://via.placeholder.com/800x600?text=No+Image");
    }
    
    string mainImg = imageUrls.First(); // ดึงรูปแรกมาเป็นรูปหลัก
}

<style>
    /* ================= ธีม Modern Minimalist ================= */
    .detail-container {
        margin: 40px auto 60px;
        max-width: 1200px;
    }
    
    /* ฝั่งรูปภาพ */
    .img-showcase {
        background: #16181f;
        border: 1px solid #222631;
        border-radius: 24px;
        padding: 20px;
        text-align: center;
        position: relative;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .main-img {
        width: 100%;
        max-height: 500px;
        object-fit: contain;
        border-radius: 16px;
    }

    .thumbnail-row {
        display: flex;
        gap: 15px;
        margin-top: 20px;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .thumbnail-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 12px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: 0.3s;
        opacity: 0.6;
        background-color: #222631;
    }

    /* สีขอบตอน Hover เปลี่ยนเป็น Indigo */
    .thumbnail-img:hover,
    .thumbnail-img.active {
        border-color: #6366f1;
        opacity: 1;
    }

    /* ป้ายสถานะส่วนลดบนรูป */
    .badge-discount-lg {
        position: absolute;
        top: 20px;
        left: 20px;
        background-color: rgba(0, 0, 0, 0.85);
        border-radius: 20px;
        padding: 6px 15px;
        font-size: 0.95rem;
        font-weight: 700;
        color: #fbbf24;
        backdrop-filter: blur(4px);
    }

    /* ฝั่งรายละเอียด */
    .category-label {
        color: #6366f1;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .product-title {
        font-size: 2.5rem;
        font-weight: 900;
        color: #ffffff;
        margin: 10px 0 20px;
        line-height: 1.2;
    }
    
    .rating-box {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
    }

    .stars {
        color: #fbbf24;
        font-size: 1.2rem;
    }

    .review-count {
        color: #64748b;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .size-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 8px;
    }

    .size-option {
        position: relative;
    }

    .size-option input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .size-option span {
        display: inline-flex;
        min-width: 46px;
        height: 42px;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
        border: 1.5px solid #cbdcf0;
        border-radius: 12px;
        background: linear-gradient(180deg, #fff 0%, #f5f9ff 100%);
        color: #173a61;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 3px 9px rgba(29, 103, 214, .08);
        transition: background .18s ease, color .18s ease, border-color .18s ease,
            box-shadow .18s ease, transform .18s ease;
    }

    .size-option:hover span {
        border-color: #1d67d6;
        background: #edf5ff;
        box-shadow: 0 5px 13px rgba(29, 103, 214, .16);
        transform: translateY(-2px);
    }

    .size-option input:disabled + span {
        border-style: dashed;
        background: #edf0f4;
        color: #94a3b8;
        cursor: not-allowed;
        box-shadow: none;
        text-decoration: line-through;
    }

    .size-option input:checked + span {
        border-color: #1555b5;
        background: linear-gradient(135deg, #2879e8 0%, #1555b5 100%);
        color: #fff;
        box-shadow: 0 5px 13px rgba(29, 103, 214, .24), 0 0 0 3px rgba(29, 103, 214, .12);
    }

    .size-option:active span {
        transform: scale(.96);
    }

    .size-option input:focus-visible + span {
        outline: 3px solid rgba(29, 103, 214, .3);
        outline-offset: 2px;
    }

    .price-box {
        background: #16181f;
        border: 1px solid #222631;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .current-price {
        font-size: 2.5rem;
        font-weight: 900;
        color: #ffffff;
        line-height: 1;
        margin-bottom: 5px;
    }

    .original-price {
        font-size: 1.2rem;
        color: #64748b;
        text-decoration: line-through;
        font-weight: 600;
    }
    
    .stock-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 0.95rem;
        margin-top: 15px;
        padding: 6px 15px;
        border-radius: 50px;
    }

    .stock-in {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .stock-out {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    /* ตัวเลือกจำนวน */
    .qty-selector {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }

    .qty-btn {
        background: #16181f;
        border: 1px solid #222631;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 1.2rem;
        transition: 0.3s;
    }

    .qty-btn:hover {
        background: #222631;
    }

    .qty-input {
        background: transparent;
        border: none;
        color: white;
        width: 50px;
        text-align: center;
        font-size: 1.2rem;
        font-weight: bold;
        outline: none;
    }

    /* ปุ่มสั่งซื้อและปุ่มหัวใจ */
    .action-buttons {
        display: flex;
        gap: 15px;
    }

    .btn-add-cart {
        flex: 1;
        background-color: #6366f1;
        color: white;
        border: none;
        border-radius: 16px;
        padding: 18px;
        font-size: 1.1rem;
        font-weight: 800;
        transition: 0.3s;
    }

    .btn-add-cart:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
        background-color: #4f46e5;
    }

    .btn-add-cart:disabled {
        background-color: #334155;
        color: #94a3b8;
        cursor: not-allowed;
    }
    
    .btn-wishlist {
        background: #16181f;
        border: 1px solid #222631;
        color: #cbd5e1;
        border-radius: 16px;
        padding: 18px 25px;
        font-size: 1.2rem;
        transition: 0.3s;
    }

    .btn-wishlist:hover {
        background: rgba(239, 68, 68, 0.1);
        border-color: #ef4444;
        color: #ef4444;
    }
    .btn-wishlist.is-favorite {
        background: #fff3f6;
        border-color: #f3b4c5;
        color: #e11d48;
    }

    /* แท็บรายละเอียดด้านล่าง */
    .details-section {
        margin-top: 50px;
        background: #16181f;
        border: 1px solid #222631;
        border-radius: 24px;
        padding: 40px;
    }

    .detail-heading {
        font-size: 1.3rem;
        font-weight: 800;
        margin-bottom: 20px;
        border-left: 4px solid #6366f1;
        padding-left: 15px;
        color: #ffffff;
    }
</style>

<div class="container detail-container">
    
    <!-- ปุ่มย้อนกลับ -->
    <a href="/Product" class="text-decoration-none d-inline-block mb-4"
       style="color: #64748b; font-weight: 600; transition: 0.3s;" onmouseover="this.style.color='#6366f1'"
       onmouseout="this.style.color='#64748b'">
        ← กลับไปหน้าสินค้าทั้งหมด
    </a>

    <div class="row g-5">
        
        <!-- ฝั่งซ้าย: รูปภาพสินค้า -->
        <div class="col-lg-6">
            <div class="img-showcase">
                @if (discountPct > 0)
                {
                    <div class="badge-discount-lg">-@discountPct%</div>
                }
                
                <img src="@mainImg" class="main-img" id="mainProductImg" alt="@Model.Name"
                     onerror="this.src='https://via.placeholder.com/800x600?text=Error'">
                @if (imageUrls.Count > 1)
                {
                    <div class="thumbnail-row">
                        @for (int i = 0; i < imageUrls.Count; i++)
                        {
                            <img src="@imageUrls[i]" class="thumbnail-img @(i == 0 ? "active" : "")"
                                 onclick="changeImage(this.src, this)"
                                 onerror="this.src='https://via.placeholder.com/150?text=Error'">
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ฝั่งขวา: ข้อมูล และ การสั่งซื้อ -->
        <div class="col-lg-6">
            <div class="category-label">@Model.Category</div>
            <h1 class="product-title">@Model.Name</h1>
            
            <div class="rating-box">
                <div class="stars">★★★★★</div>
                <div class="review-count">@Model.ReviewCount รีวิวจากผู้ซื้อจริง</div>
            </div>

            <div class="price-box">
                <div class="current-price">฿@Model.Price.ToString("N0")</div>
                @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
                {
                    <div class="original-price">ราคาปกติ ฿@Model.OriginalPrice.Value.ToString("N0")</div>
                }
                
                <!-- สถานะสต็อก -->
                @if (inStock)
                {
                    <div class="stock-status stock-in">✓ มีสินค้าพร้อมส่ง (@availableStock ชิ้น)</div>
                }
                else
                {
                    <div class="stock-status stock-out">✕ สินค้าหมดชั่วคราว</div>
                }
            </div>

            <!-- ฟอร์มเพิ่มลงตะกร้า -->
            <form action="/Cart/Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId">
                <input type="hidden" name="returnUrl" value="@favoriteReturnUrl">

                @if (TempData["CartError"] != null)
                {
                    <div class="alert alert-warning">@TempData["CartError"]</div>
                }

                @if (requiresClothingSize)
                {
                    <div class="mb-3">
                        <div class="form-label fw-bold" style="color: #cbd5e1;">เลือกไซส์เสื้อ</div>
                        <div class="size-options" role="radiogroup" aria-label="Clothing sizes">
                            @foreach (var size in clothingSizes)
                            {
                                var sizeStock = clothingSizeStocks.TryGetValue(size, out var savedStock) ? savedStock : 0;
                                <label class="size-option">
                                    <input type="radio" name="size" value="@size" data-stock="@sizeStock" required disabled="@(sizeStock <= 0)" />
                                    <span>@size@if (sizeStock <= 0) { <small class="ms-1">หมด</small> }</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                
                <div class="mb-2 fw-bold" style="color: #cbd5e1; font-size: 0.95rem;">ระบุจำนวน</div>
                <div class="qty-selector">
                    <button type="button" class="qty-btn" onclick="updateQty(-1)">-</button>
                    <input type="text" id="qtyInput" name="quantity" class="qty-input" value="1" max="@availableStock" readonly>
                    <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
                </div>

                <div class="action-buttons">
                    <button type="submit" class="btn-add-cart" @(inStock ? "" : "disabled")>
                        <i class="fa-solid fa-cart-plus me-2"></i> @(inStock ? "หยิบใส่ตะกร้า" : "สินค้าหมด")
                    </button>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="submit"
                                class="btn-wishlist @(isFavorite ? "is-favorite" : "")"
                                title="@(isFavorite ? "นำออกจากสินค้าที่ชอบ" : "เพิ่มในสินค้าที่ชอบ")"
                                aria-label="@(isFavorite ? "นำออกจากสินค้าที่ชอบ" : "เพิ่มในสินค้าที่ชอบ")"
                                aria-pressed="@isFavorite"
                                formaction="@Url.Action("ToggleFavorite", "Account")"
                                formnovalidate>
                            <i class="fa-heart @(isFavorite ? "fa-solid" : "fa-regular")"></i>
                        </button>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn-wishlist" title="เข้าสู่ระบบเพื่อบันทึกสินค้าที่ชอบ" aria-label="เข้าสู่ระบบเพื่อบันทึกสินค้าที่ชอบ">
                            <i class="fa-regular fa-heart"></i>
                        </a>
                    }
                </div>
            </form>
            
            <!-- ข้อมูลลิขสิทธิ์ -->
            <div class="mt-4 p-3"
                 style="background: #edf5ff; border: 1px dashed #b6d2f2; border-radius: 12px;">
                <div style="color: #1d67d6; font-weight: 700; font-size: 0.9rem;">
                    สินค้าลิขสิทธิ์แท้ 100% รับประกันการคืนเงินภายใน 7 วัน
                </div>
            </div>

        </div>
    </div>

    <!-- ================= ส่วนรายละเอียดเพิ่มเติม ================= -->
    <div class="details-section">
        <h3 class="detail-heading">รายละเอียดสินค้า</h3>
        <div style="color: #cbd5e1; line-height: 1.8; font-size: 1.05rem; white-space: pre-line;">
            @(string.IsNullOrEmpty(Model.Description) ? "ยังไม่มีรายละเอียดสินค้า" : Model.Description)
        </div>
        
        <h3 class="detail-heading mt-5">ข้อมูลลิขสิทธิ์และการรับประกัน</h3>
        <div style="color: #cbd5e1; line-height: 1.8; font-size: 1.05rem; white-space: pre-line;">
            @(string.IsNullOrEmpty(Model.WarrantyInfo) ? "ไม่มีข้อมูลการรับประกัน" : Model.WarrantyInfo)
        </div>
    </div>
</div>

</div>

<!-- Script จัดการรูปภาพและปุ่มจำนวน -->
<script>
    function changeImage(src, clickedElement) {
        document.getElementById('mainProductImg').src = src;
        
        const thumbnails = document.querySelectorAll('.thumbnail-img');
        thumbnails.forEach(t => t.classList.remove('active'));
        
        if (clickedElement) {
            clickedElement.classList.add('active');
        }
    }

    function updateQty(change) {
        const input = document.getElementById('qtyInput');
        let currentQty = parseInt(input.value);
        let maxStock = parseInt(input.max);
        
        let newQty = currentQty + change;
        
        // ห้ามลดต่ำกว่า 1 และห้ามสั่งเกินสต็อก
        if (newQty >= 1 && newQty <= maxStock) {
            input.value = newQty;
        }
    }

    document.querySelectorAll('input[name="size"]').forEach(function(sizeInput) {
        sizeInput.addEventListener('change', function() {
            const quantityInput = document.getElementById('qtyInput');
            const maxStock = parseInt(this.dataset.stock, 10);
            quantityInput.max = maxStock;
            quantityInput.value = Math.min(parseInt(quantityInput.value, 10) || 1, maxStock);
        });
    });
</script>