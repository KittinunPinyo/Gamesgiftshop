<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #f4f7f6; font-family: 'Segoe UI', Tahoma, sans-serif; }
        .staff-sidebar { height: 100vh; width: 250px; position: fixed; inset: 0 auto 0 0; background: #174b57; color: #fff; display: flex; flex-direction: column; z-index: 1000; }
        .staff-brand { padding: 24px 20px; font-size: 1.35rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.15); }
        .staff-menu { list-style: none; padding: 18px 0; margin: 0; flex: 1; }
        .staff-menu a { display: flex; gap: 12px; align-items: center; padding: 14px 22px; color: rgba(255,255,255,.82); text-decoration: none; border-left: 4px solid transparent; }
        .staff-menu a:hover, .staff-menu a.active { color: #fff; background: rgba(255,255,255,.12); border-left-color: #fff; }
        .staff-content { margin-left: 250px; padding: 30px; min-height: 100vh; }
        @@media (max-width: 768px) {
            .staff-sidebar { width: 68px; }
            .staff-brand { font-size: 0; padding: 22px; }
            .staff-brand i { font-size: 1.35rem; }
            .staff-menu a { justify-content: center; padding: 16px 8px; }
            .staff-menu a span { display: none; }
            .staff-content { margin-left: 68px; padding: 18px 12px; }
        }
    </style>
    <link rel="stylesheet" href="~/css/staff-theme.css" asp-append-version="true" />
</head>
<body class="staff-theme">
    <nav class="staff-sidebar">
        <div class="staff-brand"><i class="fa-solid fa-boxes-stacked me-2"></i><span>Staff Panel</span></div>
        <ul class="staff-menu">
            @if (User.IsInRole("Admin"))
            {
                <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-shield-halved"></i><span>Admin Console</span></a></li>
            }
            <li><a asp-controller="Staff" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"><i class="fa-solid fa-clipboard-list"></i><span>จัดเตรียมคำสั่งซื้อ</span></a></li>
            <li><a asp-controller="Staff" asp-action="Inventory" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Inventory" ? "active" : "")"><i class="fa-solid fa-boxes-stacked"></i><span>รับสินค้าเข้าคลัง</span></a></li>
        </ul>
        <ul class="staff-menu border-top border-light border-opacity-25 flex-grow-0">
            <li><a asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket"></i><span>ออกจากระบบ</span></a></li>
        </ul>
    </nav>
    <main class="staff-content">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
