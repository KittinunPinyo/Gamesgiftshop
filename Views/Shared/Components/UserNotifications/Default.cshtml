@model IReadOnlyList<Gamesgiftshop.Models.UserNotification>
@{
    var unreadCount = (int)ViewBag.UnreadCount;
}

<div class="dropdown">
    <button class="action-item border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="แจ้งเตือน">
        <span class="action-icon">
            <i class="fa-solid fa-bell"></i>
            @if (unreadCount > 0)
            {
                <span class="cart-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
            }
        </span>
        <span class="d-none d-lg-inline"></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end user-notification-menu p-2">
        <li><h6 class="dropdown-header text-light">การแจ้งเตือน</h6></li>
        @if (Model.Count == 0)
        {
            <li><div class="px-3 py-2 small text-secondary">ยังไม่มีการแจ้งเตือน</div></li>
        }
        else
        {
            @foreach (var notification in Model)
            {
                <li>
                    <form asp-controller="Account" asp-action="OpenNotification" method="post">
                        <input type="hidden" name="notificationId" value="@notification.UserNotificationId" />
                        <button type="submit" class="dropdown-item user-notification-item rounded-2 @(notification.IsRead ? "" : "notification-unread")">
                            <span class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold">@notification.Title</span>
                                @if (!notification.IsRead)
                                {
                                    <span class="badge text-bg-primary">ใหม่</span>
                                }
                            </span>
                            <span class="d-block small text-secondary mt-1">@notification.Message</span>
                            <span class="d-block small text-secondary mt-1">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </button>
                    </form>
                </li>
            }
        }
    </ul>
</div>

<style>
    .user-notification-menu { width: min(360px, calc(100vw - 24px)); max-height: 420px; overflow-y: auto; background: #fff; border: 1px solid #dce8f5; box-shadow: 0 12px 30px rgba(36, 76, 120, .12); }
    .user-notification-item { white-space: normal; color: #173a61; }
    .user-notification-item:hover { color: #1555b5; background: #edf5ff; }
    .notification-unread { background: #f0f6ff; }
</style>
