@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Accounting Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { margin: 0; background: #f3f7f5; color: #173a35; font-family: 'Segoe UI', Tahoma, sans-serif; }
        .accounting-sidebar { position: fixed; inset: 76px auto 0 0; z-index: 1000; display: flex; flex-direction: column; width: 250px; height: calc(100vh - 76px); color: #fff; background: #176b58; }
        .accounting-brand { padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,.16); font-size: 1.2rem; font-weight: 700; }
        .accounting-menu { flex: 1; margin: 0; padding: 18px 0; list-style: none; }
        .accounting-menu a { display: flex; align-items: center; gap: 12px; padding: 14px 22px; color: rgba(255,255,255,.85); text-decoration: none; border-left: 4px solid transparent; }
        .accounting-menu a:hover, .accounting-menu a.active { color: #fff; background: rgba(255,255,255,.13); border-left-color: #fff; }
        .accounting-content { min-height: 100vh; margin-left: 250px; padding: 30px; }
        @@media (max-width: 768px) {
            .accounting-sidebar { top: 76px; width: 68px; }
            .accounting-brand { padding: 22px; font-size: 0; }
            .accounting-brand i { font-size: 1.2rem; }
            .accounting-menu a { justify-content: center; padding: 16px 8px; }
            .accounting-menu a span { display: none; }
            .accounting-content { margin-left: 68px; padding: 18px 12px; }
        }
    </style>
    <link rel="stylesheet" href="~/css/role-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accounting-theme.css" asp-append-version="true" />
</head>
<body class="accounting-theme">
    @await Html.PartialAsync("_RoleHeader")

    <nav class="accounting-sidebar">
        <div class="accounting-brand"><i class="fa-solid fa-calculator me-2"></i><span>Accounting Panel</span></div>
        <ul class="accounting-menu">
            @if (User.IsInRole("Admin"))
            {
                <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-shield-halved"></i><span>Admin Console</span></a></li>
            }
            <li><a asp-controller="Accounting" asp-action="Dashboard" class="@(currentAction == "Dashboard" ? "active" : "")"><i class="fa-solid fa-chart-line"></i><span>บัญชีรายรับรายจ่าย</span></a></li>
            <li><a asp-controller="Accounting" asp-action="Payments" class="@(currentAction == "Payments" ? "active" : "")"><i class="fa-solid fa-money-check-dollar"></i><span>ตรวจสอบการชำระเงิน</span></a></li>
        </ul>
    </nav>
    <main class="accounting-content">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
